<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:Romodoro.Views" xmlns:clock="using:Romodoro.Clock" xmlns:stopwatch="using:Romodoro.Stopwatch" xmlns:pomodoro="using:Romodoro.Pomodoro" x:Class="Romodoro.MainWindow" x:Name="RootWindow" Title="Romodoro" Icon="/Assets/AppIcon.ico" Background="Transparent" TransparencyLevelHint="Transparent" WindowDecorations="None" CanResize="True" ShowInTaskbar="True" ExtendClientAreaToDecorationsHint="True" Width="400" Height="680" MinWidth="320" MinHeight="420" Topmost="{Binding IsTopmost}">
  <Window.Styles>
    <Style Selector="TextBlock.time"><Setter Property="FontFamily" Value="{DynamicResource InterFont}"/><Setter Property="FontSize" Value="48"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
    <Style Selector="TextBlock.time.pomo"><Setter Property="FontSize" Value="56"/></Style>
    <Style Selector="TextBlock.date"><Setter Property="FontFamily" Value="{DynamicResource InterFont}"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/></Style>
    <Style Selector="TextBlock.footer"><Setter Property="FontFamily" Value="{DynamicResource InterFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
    <Style Selector="Button.mode"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="FontFamily" Value="{DynamicResource InterFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Bottom"/></Style>
    <Style Selector="Button.mode.active"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.mode StackPanel"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
    <Style Selector="Button.mode Path"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
    <Style Selector="Button.mode TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
    <Style Selector="Button.round"><Setter Property="Width" Value="54"/><Setter Property="Height" Value="54"/><Setter Property="CornerRadius" Value="27"/><Setter Property="Background" Value="#25272B"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="FontSize" Value="20"/></Style>
    <Style Selector="Button.round.primary"><Setter Property="Width" Value="58"/><Setter Property="Height" Value="58"/><Setter Property="CornerRadius" Value="29"/><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="24"/></Style>
    <Style Selector="CheckBox.topmost"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="FontFamily" Value="{DynamicResource InterFont}"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="Button.window-control"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="CornerRadius" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.window-control:pointerover"><Setter Property="Background" Value="#25272B"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
    <Style Selector="Button.window-control.close:pointerover"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Style>
  </Window.Styles>
  <Grid>
  <Border Margin="1" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" ClipToBounds="True">
    <Grid RowDefinitions="44,*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,4,6,0" Background="Transparent">
        <Border Grid.Column="0" Background="Transparent" PointerPressed="TitleBar_OnPointerPressed"/>
        <StackPanel Grid.Column="0" IsHitTestVisible="False" Orientation="Horizontal" VerticalAlignment="Center" Spacing="9" Margin="8,0,0,0">
          <Image Source="/Assets/romodoro-alpha.png" Width="22" Height="22" Stretch="Uniform"/>
          <TextBlock Text="Romodoro" VerticalAlignment="Center" FontFamily="{DynamicResource InterFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
          <Button Classes="window-control" ToolTip.Tip="Minimizar" AutomationProperties.Name="Minimizar janela" Click="MinimizeButton_OnClick">
            <PathIcon Width="12" Height="12" Data="M 2,7 L 14,7 L 14,9 L 2,9 Z"/>
          </Button>
          <Button Classes="window-control close" ToolTip.Tip="Fechar" AutomationProperties.Name="Fechar janela" Click="CloseButton_OnClick">
            <PathIcon Width="12" Height="12" Data="M 3.7,3 L 8,7.3 L 12.3,3 L 13,3.7 L 8.7,8 L 13,12.3 L 12.3,13 L 8,8.7 L 3.7,13 L 3,12.3 L 7.3,8 L 3,3.7 Z"/>
          </Button>
        </StackPanel>
      </Grid>
      <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="{x:Type clock:ClockViewModel}"><views:ClockView/></DataTemplate>
        <DataTemplate DataType="{x:Type stopwatch:StopwatchViewModel}"><views:StopwatchView/></DataTemplate>
        <DataTemplate DataType="{x:Type pomodoro:PomodoroViewModel}"><views:PomodoroView/></DataTemplate>
      </ContentControl.DataTemplates>
      </ContentControl>
      <CheckBox Grid.Row="2" Classes="topmost" Content="Sempre no topo" IsChecked="{Binding IsTopmost}" Margin="23,8,0,14" />
    </Grid>
  </Border>
  <Grid IsHitTestVisible="True">
    <Border Height="6" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" Tag="North" PointerPressed="ResizeGrip_OnPointerPressed"/>
    <Border Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" Tag="East" PointerPressed="ResizeGrip_OnPointerPressed"/>
    <Border Height="6" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" Tag="South" PointerPressed="ResizeGrip_OnPointerPressed"/>
    <Border Width="6" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" Tag="West" PointerPressed="ResizeGrip_OnPointerPressed"/>
    <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="ResizeGrip_OnPointerPressed"/>
    <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="ResizeGrip_OnPointerPressed"/>
    <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="ResizeGrip_OnPointerPressed"/>
    <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="ResizeGrip_OnPointerPressed"/>
  </Grid>
  </Grid>
</Window>
